NODE_ENV=development
PORT=3001

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT — use a long random string (32+ characters)
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Resend — get your API key at resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=CarParts Finder

# File uploads
UPLOAD_DIR=./uploads
BACKEND_URL=http://localhost:3001

# CORS — your frontend URL
FRONTEND_URL=http://localhost:5173

# Admin email for contact form notifications
ADMIN_EMAIL=admin@yourdomain.com

# Email provider: "resend" (default) or "smtp" (e.g. Gmail, temporary)
EMAIL_PROVIDER=resend
# Only used when EMAIL_PROVIDER=smtp. Gmail needs an App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourname@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
